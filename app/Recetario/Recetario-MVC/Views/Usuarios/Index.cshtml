@model UsuariosPaginaViewModel
@using RecetarioMVC.Data
@{
    ViewData["Title"] = "Usuarios";
    ViewData["SinTitulo"] = true; // los títulos de cada rol ubican solos
    var total = Model.Administradores.Count + Model.Cocina.Count + Model.SinRol.Count;
}

<div class="filtros-cocina">
    <span class="rsp-resumen">
        <b>@total</b> @(total == 1 ? "usuario" : "usuarios")
    </span>
    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 ms-auto flex-shrink-0"
            data-bs-toggle="modal" data-bs-target="#modalCrear">
        <i class="bi bi-plus-lg"></i> Nuevo usuario
    </button>
</div>

@* Los dos roles lado a lado: se ve de un vistazo cuánta gente puede administrar *@
<div class="usr-columnas">
    <div>
        <h4 class="usr-titulo">ADMINISTRADORES · @Model.Administradores.Count</h4>
        @foreach (var usuario in Model.Administradores)
        {
            <partial name="_Usuario" model="usuario" />
        }
    </div>
    <div>
        <h4 class="usr-titulo">COCINA · @Model.Cocina.Count</h4>
        @if (Model.Cocina.Count == 0)
        {
            <p class="text-muted small">Nadie de cocina todavía: sin usuarios acá, nadie puede armar comandas.</p>
        }
        @foreach (var usuario in Model.Cocina)
        {
            <partial name="_Usuario" model="usuario" />
        }
    </div>
</div>

@if (Model.SinRol.Count > 0)
{
    <div class="mt-3">
        <h4 class="usr-titulo sin-rol">SIN ROL · @Model.SinRol.Count</h4>
        <p class="text-muted small">Pueden entrar, pero no ven ninguna pantalla hasta que tengan un rol.</p>
        @foreach (var usuario in Model.SinRol)
        {
            <partial name="_Usuario" model="usuario" />
        }
    </div>
}

@* ============ Alta ============ *@
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row">
                        <div class="col mb-3">
                            <label asp-for="Nuevo.Nombre" class="form-label">
                                <span class="req text-danger">*</span> Nombre
                            </label>
                            <input asp-for="Nuevo.Nombre" class="form-control" />
                            <span asp-validation-for="Nuevo.Nombre" class="text-danger"></span>
                        </div>
                        <div class="col mb-3">
                            <label asp-for="Nuevo.Apellido" class="form-label">
                                <span class="req text-danger">*</span> Apellido
                            </label>
                            <input asp-for="Nuevo.Apellido" class="form-control" />
                            <span asp-validation-for="Nuevo.Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nuevo.Email" class="form-label">
                            <span class="req text-danger">*</span> Email
                        </label>
                        <input asp-for="Nuevo.Email" class="form-control" />
                        <span asp-validation-for="Nuevo.Email" class="text-danger"></span>
                        <div class="form-text">Con este email inicia sesión.</div>
                    </div>

                    <div class="row">
                        <div class="col mb-1">
                            <label asp-for="Nuevo.Rol" class="form-label">
                                <span class="req text-danger">*</span> Rol
                            </label>
                            <select asp-for="Nuevo.Rol" class="form-select">
                                <option value="">Elegí un rol…</option>
                                <option value="@DbSeeder.RolCocina">Cocina — arma comandas</option>
                                <option value="@DbSeeder.RolAdmin">Admin — gestiona todo</option>
                            </select>
                            <span asp-validation-for="Nuevo.Rol" class="text-danger"></span>
                        </div>
                        <div class="col mb-1">
                            <label asp-for="Nuevo.Password" class="form-label">
                                <span class="req text-danger">*</span> Contraseña inicial
                            </label>
                            <input asp-for="Nuevo.Password" class="form-control" />
                            <span asp-validation-for="Nuevo.Password" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ============ Restablecer contraseña ============ *@
<div class="modal fade" id="modalPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="RestablecerPassword" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Contraseña de <span id="modalPasswordNombre"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input asp-for="NuevaPassword.Id" type="hidden" />

                    <div class="mb-1">
                        <label asp-for="NuevaPassword.Password" class="form-label">
                            <span class="req text-danger">*</span> Contraseña nueva
                        </label>
                        <input asp-for="NuevaPassword.Password" class="form-control" />
                        <span asp-validation-for="NuevaPassword.Password" class="text-danger"></span>
                    </div>
                    <div class="form-text mt-2">
                        Se reemplaza la actual sin pedir la anterior. Pasásela a la persona
                        para que la cambie desde su cuenta.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Restablecer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Un solo modal de contraseña: el usuario que se toca le pasa su id
        document.getElementById("modalPassword").addEventListener("show.bs.modal", function (evento) {
            const boton = evento.relatedTarget;
            if (!boton) return;

            document.getElementById("modalPasswordNombre").textContent = boton.dataset.nombre;
            document.getElementById("NuevaPassword_Id").value = boton.dataset.id;
            document.getElementById("NuevaPassword_Password").value = "";
        });
    </script>
    @if (Model.ModalAbierto is not null)
    {
        @* El formulario volvió con errores: se reabre donde estaba *@
        <script>
            new bootstrap.Modal(document.getElementById("@Model.ModalAbierto")).show();
        </script>
    }
}
