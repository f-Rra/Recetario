@model RecetaDetalleViewModel
@using RecetarioMVC.Data
@{
    ViewData["Title"] = Model.Nombre;
    ViewData["SinTitulo"] = true; // la cabecera ya lleva el nombre de la receta
    var esAdmin = User.IsInRole(DbSeeder.RolAdmin);
}

<a asp-action="Index" class="dtc-volver">
    <i class="bi bi-arrow-left"></i> Volver a recetas
</a>

<div class="dtc-cabecera">
    <div class="dtc-titulo">
        <div class="nombre">@Model.Nombre</div>
        <div class="meta">
            @Model.Codigo · @Model.Clasificacion
            @if (!Model.Activo)
            {
                <span class="text-muted">· inactiva</span>
            }
        </div>
    </div>
    <div class="dtc-numero">
        <b>@Model.PorcionesBase</b>
        <span>PORCIONES BASE</span>
    </div>
    @if (esAdmin)
    {
        <a asp-controller="Costos" asp-action="Costear" asp-route-id="@Model.IdReceta"
           class="btn btn-outline-primary btn-sm rounded-pill px-3">Costear</a>
        <a asp-action="Editar" asp-route-id="@Model.IdReceta"
           class="btn btn-outline-primary btn-sm rounded-pill px-3">Editar</a>
    }
</div>

<div class="dtc-columnas">
    <div class="dtc-tarjeta">
        <h4>INGREDIENTES</h4>
        @if (Model.Ingredientes.Count == 0)
        {
            <p class="text-muted mb-0">Sin ingredientes cargados.</p>
        }
        else
        {
            @* La cantidad bruta: es la que hay que preparar y la que la comanda
               escala a los comensales *@
            <div class="dtc-lista">
                @foreach (var ing in Model.Ingredientes)
                {
                    <div>
                        <span>@ing.Ingrediente</span>
                        <span class="pts"></span>
                        <span>@FormatoCantidad.Formatear(ing.CantBruta, ing.Unidad)</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="dtc-tarjeta">
        <h4>PROCEDIMIENTO</h4>
        @if (Model.Pasos.Count == 0)
        {
            <p class="text-muted mb-0">Sin pasos cargados.</p>
        }
        else
        {
            @foreach (var paso in Model.Pasos)
            {
                <div class="dtc-paso">
                    <i>@paso.NroPaso</i>
                    <span>@paso.Descripcion</span>
                </div>
            }
        }
    </div>
</div>
