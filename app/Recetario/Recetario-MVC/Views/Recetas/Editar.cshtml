@model RecetaDetalleViewModel
@{
    ViewData["Title"] = $"Editar — {Model.Nombre}";
    ViewData["SinTitulo"] = true; // la barra de datos encabeza la pantalla
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="dtc-volver mb-0">
        <i class="bi bi-arrow-left"></i> Volver a recetas
    </a>
    <div class="d-flex gap-2">
        <a asp-action="Detalle" asp-route-id="@Model.IdReceta"
           class="btn btn-outline-primary btn-sm rounded-pill px-3">Ver como cocina</a>
        <a asp-controller="Costos" asp-action="Costear" asp-route-id="@Model.IdReceta"
           class="btn btn-outline-primary btn-sm rounded-pill px-3">Costear</a>
    </div>
</div>

@* ---------- Los datos, en una barra ---------- *@
<form asp-action="EditarDatos" method="post" class="rec-datos">
    <input type="hidden" asp-for="Datos.IdReceta" />
    <div class="campo codigo">
        <label asp-for="Datos.Codigo" class="form-label"></label>
        <input asp-for="Datos.Codigo" class="form-control form-control-sm" readonly />
    </div>
    <div class="campo nombre">
        <label asp-for="Datos.Nombre" class="form-label"><span class="req text-danger">*</span> Nombre</label>
        <input asp-for="Datos.Nombre" class="form-control form-control-sm" />
        <span asp-validation-for="Datos.Nombre" class="text-danger"></span>
    </div>
    <div class="campo clasificacion">
        <label asp-for="Datos.IdClasificacion" class="form-label"><span class="req text-danger">*</span> Clasificación</label>
        <select asp-for="Datos.IdClasificacion" asp-items="ViewBag.Clasificaciones" class="form-select form-select-sm">
            <option value="">Elegí una…</option>
        </select>
    </div>
    <div class="campo porciones">
        <label asp-for="Datos.PorcionesBase" class="form-label"><span class="req text-danger">*</span> Porciones base</label>
        <input asp-for="Datos.PorcionesBase" class="form-control form-control-sm" />
        <span asp-validation-for="Datos.PorcionesBase" class="text-danger"></span>
    </div>
    <div class="form-check activa">
        <input asp-for="Datos.Activo" class="form-check-input" />
        <label asp-for="Datos.Activo" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Guardar</button>
</form>

<div class="rec-columnas">
    @* ---------- Ingredientes ---------- *@
    <div class="mdt-panel">
        <h4>INGREDIENTES · @Model.Ingredientes.Count</h4>

        @if (Model.Ingredientes.Count == 0)
        {
            <p class="text-muted">Todavía no tiene ingredientes: sin ellos no se puede costear ni armar una comanda.</p>
        }
        else
        {
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ingrediente</th>
                        <th class="num">Neta</th>
                        <th class="num">Rend.</th>
                        <th class="num">Bruta</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ing in Model.Ingredientes)
                    {
                        <tr>
                            <td>@ing.Ingrediente</td>
                            <td class="num text-muted">@FormatoCantidad.Formatear(ing.CantNeta, ing.Unidad)</td>
                            <td class="num text-muted">@ing.Rendimiento.ToString("N0")%</td>
                            <td class="num fw-semibold">@FormatoCantidad.Formatear(ing.CantBruta, ing.Unidad)</td>
                            <td class="text-end">
                                <form asp-action="QuitarIngrediente" method="post" class="d-inline">
                                    <input type="hidden" name="idReceta" value="@Model.IdReceta" />
                                    <input type="hidden" name="idIngrediente" value="@ing.IdIngrediente" />
                                    <button type="submit" class="rec-quitar" title="Quitar">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* La fila de carga vive al pie del panel, donde termina la lista *@
        <form asp-action="AgregarIngrediente" method="post" class="rec-agregar">
            <input type="hidden" asp-for="NuevoIngrediente.IdReceta" />
            <select asp-for="NuevoIngrediente.IdIngrediente" asp-items="ViewBag.Ingredientes"
                    class="form-select form-select-sm" style="flex: 2;">
                <option value="">Elegí un ingrediente…</option>
            </select>
            <input asp-for="NuevoIngrediente.CantNeta" class="form-control form-control-sm"
                   placeholder="Neta" style="width: 82px;" />
            <input asp-for="NuevoIngrediente.Rendimiento" class="form-control form-control-sm"
                   placeholder="Rend." style="width: 72px;" />
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-plus-lg"></i>
            </button>
        </form>
        <div class="form-text mt-2">
            La bruta se calcula sola: neta ÷ (rendimiento ÷ 100). Rendimiento 100 = sin desperdicio.
        </div>
    </div>

    @* ---------- Procedimiento ---------- *@
    <div class="mdt-panel">
        <h4>PROCEDIMIENTO · @Model.Pasos.Count @(Model.Pasos.Count == 1 ? "PASO" : "PASOS")</h4>

        @if (Model.Pasos.Count == 0)
        {
            <p class="text-muted">
                Todavía no tiene pasos: la comanda va a salir sin instrucciones.
            </p>
        }
        else
        {
            @foreach (var paso in Model.Pasos)
            {
                <div class="rec-paso">
                    <i>@paso.NroPaso</i>
                    <span>@paso.Descripcion</span>
                    <form asp-action="QuitarPaso" method="post" class="d-inline">
                        <input type="hidden" name="idProcedimiento" value="@paso.IdProcedimiento" />
                        <input type="hidden" name="idReceta" value="@Model.IdReceta" />
                        <button type="submit" class="rec-quitar" title="Quitar paso">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </form>
                </div>
            }
        }

        <form asp-action="AgregarPaso" method="post" class="rec-agregar">
            <input type="hidden" asp-for="NuevoPaso.IdReceta" />
            <input asp-for="NuevoPaso.Descripcion" class="form-control form-control-sm"
                   placeholder="Describí el paso siguiente…" style="flex: 1;" />
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-plus-lg"></i>
            </button>
        </form>
        <div class="form-text mt-2">
            Los pasos se numeran solos, en el orden en que se agregan.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
