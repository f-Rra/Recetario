@model List<RecetaListaItem>
@using RecetarioMVC.Data
@{
    ViewData["Title"] = "Recetas";
    ViewData["SinTitulo"] = true; // la grilla de fichas se lee sola
    var esAdmin = User.IsInRole(DbSeeder.RolAdmin);
    var busqueda = (string?)ViewData["Busqueda"];
    var clasificacion = (int?)ViewData["Clasificacion"];
    var clasificaciones = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clasificaciones;
}

<div class="filtros-cocina">
    <form method="get" class="busca-cocina" role="search">
        <input type="hidden" name="clasificacion" value="@clasificacion" />
        <input type="search" name="busqueda" value="@busqueda"
               class="form-control form-control-sm" placeholder="Buscar…" />
        <button type="submit" class="btn btn-primary btn-sm lupa-cocina" title="Buscar">
            <i class="bi bi-search"></i>
        </button>
    </form>

    <div class="chips-cocina">
        <a href="@Url.Action("Index", new { busqueda })"
           class="@(clasificacion is null ? "activa" : "")">Todas</a>
        @foreach (var c in clasificaciones)
        {
            <a href="@Url.Action("Index", new { busqueda, clasificacion = c.Value })"
               class="@(c.Selected ? "activa" : "")">@c.Text</a>
        }
    </div>

    @if (esAdmin)
    {
        <a asp-action="Crear" class="btn btn-primary btn-sm rounded-pill px-3 ms-auto flex-shrink-0">
            <i class="bi bi-plus-lg"></i> Nueva receta
        </a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-journal-text" style="font-size: 28px; color: var(--sx-celeste);"></i>
        <p class="mb-0 mt-2">
            @(string.IsNullOrWhiteSpace(busqueda) && clasificacion is null
                ? "Todavía no hay recetas cargadas."
                : "No se encontraron recetas con esos filtros.")
        </p>
    </div>
}
else
{
    <div class="fch-grilla">
        @foreach (var item in Model)
        {
            <div class="fch @(item.Activo ? "" : "inactiva")">
                @if (!item.Completa)
                {
                    <span class="fch-cinta" title="@item.Advertencia">@item.AdvertenciaCorta</span>
                }

                <div class="fch-sector">@item.Clasificacion.ToUpperInvariant()</div>
                <div class="fch-nombre">@item.Nombre</div>
                <div class="fch-meta">
                    @item.CantidadIngredientes @(item.CantidadIngredientes == 1 ? "ingrediente" : "ingredientes")
                    @if (item.CantidadPasos > 0)
                    {
                        <text>· @item.CantidadPasos @(item.CantidadPasos == 1 ? "paso" : "pasos")</text>
                    }
                    @if (!item.Activo)
                    {
                        <text>· inactiva</text>
                    }
                </div>

                @if (item.IngredienteCoincidente is not null)
                {
                    <span class="fch-lleva">lleva @item.IngredienteCoincidente</span>
                }

                <div class="fch-acciones">
                    <a asp-action="Detalle" asp-route-id="@item.IdReceta"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3">Ver receta</a>
                    @if (esAdmin)
                    {
                        <a asp-controller="Costos" asp-action="Costear" asp-route-id="@item.IdReceta"
                           class="btn btn-outline-primary btn-sm" title="Costear">
                            <i class="bi bi-currency-dollar"></i>
                        </a>
                        <a asp-action="Editar" asp-route-id="@item.IdReceta"
                           class="btn btn-outline-primary btn-sm" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                data-id="@item.IdReceta" data-nombre="@item.Nombre">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@if (esAdmin)
{
    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar receta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    Se va a eliminar <b id="modalEliminarNombre"></b> con sus ingredientes y procedimiento.
                    Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Eliminar" method="post" class="d-inline">
                        <input type="hidden" name="id" id="modalEliminarId" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const modal = document.getElementById("modalEliminar");
        if (modal) {
            modal.addEventListener("show.bs.modal", function (evento) {
                const boton = evento.relatedTarget;
                document.getElementById("modalEliminarId").value = boton.dataset.id;
                document.getElementById("modalEliminarNombre").textContent = boton.dataset.nombre;
            });
        }
    </script>
}
