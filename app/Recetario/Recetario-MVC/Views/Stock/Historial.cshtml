@model HistorialFiltrosViewModel
@using RecetarioMVC.Models
@{
    ViewData["Title"] = "Historial de movimientos";
}

<a asp-action="Index" class="dtc-volver">
    <i class="bi bi-arrow-left"></i> Volver a stock
</a>

<div class="hst-filtros">
    <span class="hst-chip">
        <b>@Model.Movimientos.Count</b>
        @(Model.Movimientos.Count == 1 ? "movimiento" : "movimientos")
    </span>

    <span class="flex-grow-1"></span>

    <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
        <select name="ingrediente" asp-items="ViewBag.Ingredientes"
                class="form-select form-select-sm hst-filtro" style="width: 210px;" aria-label="Ingrediente">
            <option value="">Todos los ingredientes</option>
        </select>
        <select name="tipo" class="form-select form-select-sm hst-filtro" aria-label="Tipo">
            <option value="">Todos los tipos</option>
            <option value="@((int)TipoMovimiento.Entrada)" selected="@(Model.Tipo == TipoMovimiento.Entrada)">Entradas</option>
            <option value="@((int)TipoMovimiento.Salida)" selected="@(Model.Tipo == TipoMovimiento.Salida)">Salidas</option>
            <option value="@((int)TipoMovimiento.Ajuste)" selected="@(Model.Tipo == TipoMovimiento.Ajuste)">Ajustes</option>
        </select>
        <input type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")"
               class="form-control form-control-sm hst-filtro" aria-label="Desde" />
        <input type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")"
               class="form-control form-control-sm hst-filtro" aria-label="Hasta" />
        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Filtrar</button>
        <a asp-action="Historial" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Limpiar</a>
    </form>
</div>

@if (Model.Movimientos.Count == 0)
{
    <div class="hst-card">
        <div class="text-center text-muted py-5">
            <i class="bi bi-clock-history" style="font-size: 28px; color: var(--sx-celeste);"></i>
            <p class="mb-0 mt-2">Sin movimientos con esos filtros.</p>
        </div>
    </div>
}
else
{
    <div class="hst-card">
        <table class="hst-tabla">
            <thead>
                <tr>
                    <th>INGREDIENTE</th>
                    <th class="text-center">TIPO</th>
                    <th class="num">CANTIDAD</th>
                    <th>USUARIO</th>
                    <th>OBSERVACIONES</th>
                </tr>
            </thead>
            <tbody>
                @* Agrupado por día, igual que el historial de comandas *@
                @foreach (var dia in Model.Movimientos.GroupBy(m => m.Fecha.Date))
                {
                    <tr class="hst-dia">
                        <td colspan="5">@dia.Key.ToString("dddd d 'de' MMMM").ToUpperInvariant()</td>
                    </tr>
                    @foreach (var m in dia)
                    {
                        <tr>
                            <td>
                                <span class="hst-ingrediente">@m.Ingrediente</span>
                                <span class="hst-hora">@m.Fecha.ToString("HH:mm")</span>
                            </td>
                            <td class="text-center">
                                @if (m.Tipo == TipoMovimiento.Entrada)
                                {
                                    <span class="badge rounded-pill badge-estado-ok">Entrada</span>
                                }
                                else if (m.Tipo == TipoMovimiento.Salida)
                                {
                                    <span class="badge rounded-pill badge-estado-critico">Salida</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill badge-estado-bajo">Ajuste</span>
                                }
                            </td>
                            <td class="num">@FormatoCantidad.Formatear(m.Cantidad, m.Unidad)</td>
                            <td>@m.Usuario</td>
                            <td class="text-muted">@(m.Observaciones ?? "—")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Movimientos.Count == 100)
    {
        <div class="form-text mt-2">
            Se muestran los últimos 100 movimientos: afiná los filtros para ver más atrás.
        </div>
    }
}
