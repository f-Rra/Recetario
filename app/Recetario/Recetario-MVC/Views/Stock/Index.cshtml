@model List<IngredienteListaItem>
@using RecetarioMVC.Data
@using RecetarioMVC.Helpers
@using RecetarioMVC.Models
@{
    ViewData["Title"] = "Stock";
    ViewData["SinTitulo"] = true; // los títulos de bodega y cámara ubican solos
    // Cocina consulta el stock; registrar movimientos es de Admin
    var puedeMover = User.IsInRole(DbSeeder.RolAdmin);
    var busqueda = (string?)ViewData["Busqueda"];
    var estado = (string?)ViewData["Estado"];

    var depositos = new[] { Deposito.Bodega, Deposito.Camara };
}

<div class="filtros-cocina">
    <form method="get" class="busca-cocina" role="search">
        <input type="hidden" name="estado" value="@estado" />
        <input type="search" name="busqueda" value="@busqueda"
               class="form-control form-control-sm" placeholder="Buscar…" />
        <button type="submit" class="btn btn-primary btn-sm lupa-cocina" title="Buscar">
            <i class="bi bi-search"></i>
        </button>
    </form>

    @* Lo urgente primero: filtra los dos depósitos a la vez *@
    <div class="chips-cocina">
        <a href="@Url.Action("Index", new { busqueda })"
           class="@(estado is null ? "activa" : "")">Todos</a>
        <a href="@Url.Action("Index", new { busqueda, estado = StockEstado.Bajo })"
           class="@(estado == StockEstado.Bajo ? "activa" : "")">Bajos</a>
        <a href="@Url.Action("Index", new { busqueda, estado = StockEstado.Critico })"
           class="@(estado == StockEstado.Critico ? "activa" : "")">Críticos</a>
    </div>

    <div class="d-flex gap-2 ms-auto flex-shrink-0">
        @if (puedeMover)
        {
            <a asp-action="Inventario" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-clipboard-check"></i> Hacer inventario
            </a>
        }
        <a asp-action="Historial" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-clock-history"></i> Movimientos
        </a>
    </div>
</div>

@* Los dos depósitos a la vista: no hay que cambiar de pestaña para comparar *@
<div class="stk-depositos">
    @foreach (var deposito in depositos)
    {
        var items = Model.Where(i => i.Deposito == deposito).ToList();

        <div class="stk-columna">
            <h2>
                @NombreDeposito.De(deposito).ToUpperInvariant()
                <span>@items.Count @(items.Count == 1 ? "ingrediente" : "ingredientes")</span>
            </h2>

            @if (items.Count == 0)
            {
                <div class="stk-vacio">
                    @(string.IsNullOrWhiteSpace(busqueda) && estado is null
                        ? $"No hay ingredientes en {NombreDeposito.De(deposito).ToLower()}."
                        : "Ninguno coincide con los filtros.")
                </div>
            }
            else
            {
                @foreach (var item in items)
                {
                    <div class="stk-fila">
                        <span class="nombre">@item.Descripcion</span>

                        @* Solo se marca lo que necesita atención *@
                        @if (item.Estado == StockEstado.Critico)
                        {
                            <span class="badge rounded-pill badge-estado-critico">Crítico</span>
                        }
                        else if (item.Estado == StockEstado.Bajo)
                        {
                            <span class="badge rounded-pill badge-estado-bajo">Bajo</span>
                        }

                        <span class="cantidad" title="Mínimo @FormatoCantidad.Formatear(item.StockMinimo, item.Unidad)">
                            @FormatoCantidad.Formatear(item.StockActual, item.Unidad)
                        </span>

                        @if (puedeMover)
                        {
                            <button type="button" class="stk-mover"
                                    data-bs-toggle="modal" data-bs-target="#modalMovimiento"
                                    data-id="@item.IdIngrediente" data-nombre="@item.Descripcion"
                                    data-unidad="@item.Unidad" title="Registrar movimiento">
                                <i class="bi bi-arrow-left-right"></i>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@if (puedeMover)
{
<div class="modal fade" id="modalMovimiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RegistrarMovimiento" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Movimiento — <span id="modalMovNombre"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="IdIngrediente" id="modalMovId" />

                    <div class="mb-3">
                        <label class="form-label" for="movTipo"><span class="req text-danger">*</span> Tipo</label>
                        <select name="Tipo" id="movTipo" class="form-select" required>
                            <option value="">Elegí el tipo…</option>
                            <option value="@((int)TipoMovimiento.Entrada)">Entrada (compra/reposición: suma)</option>
                            <option value="@((int)TipoMovimiento.Salida)">Salida (merma/uso fuera de comanda: resta)</option>
                            <option value="@((int)TipoMovimiento.Ajuste)">Ajuste (inventario: deja el stock en el valor contado)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="movCantidad"><span class="req text-danger">*</span> Cantidad (<span id="modalMovUnidad"></span>)</label>
                        <input name="Cantidad" id="movCantidad" class="form-control" placeholder="0,00" required />
                    </div>

                    <div class="mb-1">
                        <label class="form-label" for="movObs">Observaciones</label>
                        <input name="Observaciones" id="movObs" class="form-control" maxlength="255" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>
}

@section Scripts {
    <script>
        const modalMov = document.getElementById("modalMovimiento");
        if (modalMov) modalMov.addEventListener("show.bs.modal", function (evento) {
            const boton = evento.relatedTarget;
            document.getElementById("modalMovId").value = boton.dataset.id;
            document.getElementById("modalMovNombre").textContent = boton.dataset.nombre;
            document.getElementById("modalMovUnidad").textContent = boton.dataset.unidad;
        });
    </script>
}
