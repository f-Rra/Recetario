@model CostearPaginaViewModel
@{
    ViewData["Title"] = "Costeo";
    ViewData["SinTitulo"] = true; // la cabecera con la receta encabeza la pantalla
    var resultado = Model.Resultado;
}

@if (Model.Recetas.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-currency-dollar" style="font-size: 28px; color: var(--sx-celeste);"></i>
        <p class="mb-0 mt-2">Todavía no hay recetas para costear.</p>
    </div>
}
else
{
    <div class="mdt">
        @* ---------- Selector de recetas ---------- *@
        <div class="mdt-lista">
            @foreach (var receta in Model.Recetas)
            {
                <a asp-action="Costear" asp-route-id="@receta.IdReceta"
                   class="@(receta.IdReceta == Model.IdReceta ? "elegido" : "")">
                    <span class="nombre">@receta.Nombre</span>
                    <span class="dato">@receta.Clasificacion</span>
                </a>
            }
        </div>

        <div>
            @* ---------- Qué se costea ---------- *@
            <div class="mdt-ficha">
                <div class="titulo">
                    <div class="nombre">@Model.Receta</div>
                    <div class="meta">@Model.Codigo · base @Model.PorcionesBase porciones</div>
                </div>
                <form asp-action="Calcular" method="post" class="cst-calcular">
                    <input type="hidden" name="idReceta" value="@Model.IdReceta" />
                    <div>
                        <label class="form-label" for="porciones">Porciones a costear</label>
                        <input type="number" id="porciones" name="porciones" value="@Model.Porciones"
                               min="1" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Calcular</button>
                </form>
            </div>

            @if (resultado is null)
            {
                <div class="mdt-panel">
                    <p class="text-muted mb-0">
                        Poné las porciones y calculá. Las cantidades se escalan usando el
                        último precio vigente de cada ingrediente.
                    </p>
                </div>
            }
            else if (resultado.IngredientesSinPrecio.Count > 0)
            {
                <div class="mdt-panel">
                    <h4 style="color: var(--sx-rojo);">NO SE PUEDE COSTEAR</h4>
                    <p class="mb-2">Estos ingredientes no tienen ningún precio cargado:</p>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        @foreach (var faltante in resultado.IngredientesSinPrecio)
                        {
                            <span class="badge rounded-pill badge-estado-critico">@faltante</span>
                        }
                    </div>
                    <p class="text-muted mb-0">
                        Cargales un precio desde
                        <a asp-controller="Ingredientes" asp-action="Index">Ingredientes</a>
                        y volvé a calcular.
                    </p>
                </div>
            }
            else if (resultado.Detalles.Count == 0)
            {
                <div class="mdt-panel">
                    <p class="text-muted mb-0">La receta no tiene ingredientes: no hay nada que costear.</p>
                </div>
            }
            else
            {
                <div class="cst-columnas">
                    <div class="mdt-panel">
                        <h4>DESGLOSE PARA @resultado.Porciones PORCIONES</h4>
                        @foreach (var d in resultado.Detalles)
                        {
                            var peso = d.Participacion(resultado.CostoTotal);
                            <div class="cst-linea">
                                <div class="cab">
                                    <span>
                                        @d.Ingrediente
                                        <span class="text-muted">
                                            @FormatoCantidad.Formatear(d.CantBruta, d.Unidad)
                                            × $ @d.PrecioUnitario.ToString("N2") · @d.Proveedor
                                        </span>
                                    </span>
                                    <b>$ @d.Subtotal.ToString("N2")</b>
                                </div>
                                @* La barra dice cuánto pesa cada ingrediente: se ve enseguida
                                   qué encarece la receta *@
                                <div class="cst-barra" title="@peso.ToString("N1")% del total">
                                    <i style="width: @peso.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;"></i>
                                </div>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="cst-total">
                            <span class="lbl">COSTO TOTAL</span>
                            <b>$ @resultado.CostoTotal.ToString("N2")</b>
                            <span class="pie">@resultado.Porciones porciones</span>
                        </div>
                        <div class="cst-total claro">
                            <span class="lbl">POR PORCIÓN</span>
                            <b>$ @resultado.CostoUnitario.ToString("N2")</b>
                        </div>
                        <form asp-action="Registrar" method="post">
                            <input type="hidden" name="idReceta" value="@Model.IdReceta" />
                            <input type="hidden" name="porciones" value="@resultado.Porciones" />
                            <button type="submit" class="btn btn-primary w-100 rounded-pill">
                                Registrar costeo
                            </button>
                        </form>
                    </div>
                </div>
            }

            @* ---------- Historial ---------- *@
            <div class="mdt-panel">
                <h4>COSTEOS REGISTRADOS</h4>
                @if (Model.Historial.Count == 0)
                {
                    <p class="text-muted mb-0">Todavía no se registró ningún costeo de esta receta.</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th class="num">Porciones</th>
                                <th class="num">Total</th>
                                <th class="num">Por porción</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Historial)
                            {
                                <tr>
                                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="num">@c.Porciones</td>
                                    <td class="num">$ @c.CostoTotal.ToString("N2")</td>
                                    <td class="num fw-semibold">$ @c.CostoUnitario.ToString("N2")</td>
                                    <td class="text-end">
                                        <a asp-action="Pdf" asp-route-id="@c.IdCosto" target="_blank"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                           title="Registrado por @c.Usuario">
                                            PDF
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}
