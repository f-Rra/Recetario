@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["SinTitulo"] = true; // las tarjetas encabezan la pantalla
    var variacion = Model.VariacionPorciones;
}

@* ---------- Las cuatro tarjetas ---------- *@
<div class="dsh-tarjetas">
    <div class="dsh-kpi">
        <div class="lbl">RECETAS ACTIVAS</div>
        <div class="val">@Model.RecetasActivas</div>
        <div class="pie">
            @if (Model.RecetasIncompletas > 0)
            {
                <span class="ambar">
                    @Model.RecetasIncompletas @(Model.RecetasIncompletas == 1 ? "incompleta" : "incompletas")
                </span>
            }
            else
            {
                <text>todas con ingredientes y pasos</text>
            }
        </div>
    </div>

    <div class="dsh-kpi">
        <div class="lbl">INGREDIENTES</div>
        <div class="val">@Model.TotalIngredientes</div>
        <div class="pie">@Model.IngredientesBodega bodega · @Model.IngredientesCamara cámara</div>
    </div>

    <div class="dsh-kpi">
        <div class="lbl">PORCIONES DEL MES</div>
        <div class="val">@Model.PorcionesDelMes.ToString("N0")</div>
        <div class="pie">
            @if (variacion is null)
            {
                <text>sin producción el mes pasado</text>
            }
            else if (variacion >= 0)
            {
                <span class="verde">+@variacion.Value.ToString("N1")% vs. el mes pasado</span>
            }
            else
            {
                <span class="rojo">@variacion.Value.ToString("N1")% vs. el mes pasado</span>
            }
        </div>
    </div>

    @* El único que habla de plata: va en azul pleno *@
    <div class="dsh-kpi destacada">
        <div class="lbl">VALOR DEL INVENTARIO</div>
        <div class="val">$ @Model.ValorInventario.ToString("N0")</div>
        <div class="pie">
            @if (Model.IngredientesValorizados < Model.TotalIngredientes)
            {
                <text>@Model.IngredientesValorizados de @Model.TotalIngredientes con precio</text>
            }
            else
            {
                <text>los @Model.TotalIngredientes valorizados</text>
            }
        </div>
    </div>
</div>

@* ---------- Los dos paneles ---------- *@
<div class="dsh-paneles">
    <div class="mdt-panel">
        <h4>STOCK BAJO</h4>
        @if (Model.StockBajo.Count == 0)
        {
            <p class="text-muted mb-0">Ningún ingrediente cerca del mínimo.</p>
        }
        else
        {
            @foreach (var item in Model.StockBajo)
            {
                <div class="dsh-fila">
                    <span>@item.Descripcion</span>
                    <span class="der">
                        <span class="text-muted">
                            @FormatoCantidad.Formatear(item.StockActual, item.Unidad) de
                            @FormatoCantidad.Formatear(item.StockMinimo, item.Unidad)
                        </span>
                        @if (item.EsCritico)
                        {
                            <span class="badge rounded-pill badge-estado-critico">Crítico</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill badge-estado-bajo">Bajo</span>
                        }
                    </span>
                </div>
            }
        }
    </div>

    <div class="mdt-panel">
        <h4>ÚLTIMAS COMANDAS</h4>
        @if (Model.UltimasComandas.Count == 0)
        {
            <p class="text-muted mb-0">Todavía no se generó ninguna comanda.</p>
        }
        else
        {
            @foreach (var comanda in Model.UltimasComandas)
            {
                <div class="dsh-fila">
                    <a asp-controller="Comandas" asp-action="Detalle" asp-route-id="@comanda.IdComanda"
                       class="enlace">@comanda.Receta</a>
                    <span class="der text-muted">
                        @comanda.Porciones @(comanda.Porciones == 1 ? "porción" : "porciones")
                        · @comanda.Fecha.ToString("dd/MM")
                    </span>
                </div>
            }
        }
    </div>
</div>

@* ---------- El registro de actividad ---------- *@
<div class="mdt-panel">
    <h4>ACTIVIDAD</h4>
    @if (Model.Actividad.Count == 0)
    {
        <p class="text-muted mb-0">Sin movimientos todavía.</p>
    }
    else
    {
        @foreach (var dia in Model.Actividad.GroupBy(a => a.Fecha))
        {
            <div class="dsh-dia">@dia.Key.ToString("dddd d 'de' MMMM").ToUpperInvariant()</div>
            <div class="dsh-feed">
                @foreach (var item in dia)
                {
                    <div class="item @item.Tipo">
                        <div class="cab">
                            <b>@item.Titulo</b>
                            @if (item.Hora is not null)
                            {
                                <span class="hora">@item.Hora.Value.ToString("HH:mm")</span>
                            }
                        </div>
                        <div class="text-muted">@item.Detalle</div>
                    </div>
                }
            </div>
        }
    }
</div>
