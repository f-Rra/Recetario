@model ErrorViewModel
@{
    // Sin el layout de la aplicación: el layout consulta el usuario en la base, y esta
    // página tiene que poder mostrarse aunque lo que falló sea justamente la base
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Titulo — Recetario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="pagina-error">
        <p class="pagina-error-codigo">Error @Model.Codigo</p>
        <h1>@Model.Titulo</h1>
        <p class="text-muted">@Model.Mensaje</p>
        <a href="~/" class="btn btn-primary">Volver al inicio</a>

        @if (Model.ShowRequestId)
        {
            <p class="pagina-error-referencia">
                Si el problema sigue, pasale este código a quien administra el sistema:
                <code>@Model.RequestId</code>
            </p>
        }
    </main>
</body>
</html>
