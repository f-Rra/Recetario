@model List<ComandaListaItem>
@{
    ViewData["Title"] = "Comandas";
    ViewData["SinTitulo"] = true; // el chip con el total y los días alcanzan
    var desde = (DateOnly?)ViewData["Desde"];
    var hasta = (DateOnly?)ViewData["Hasta"];
    var hoy = DateOnly.FromDateTime(DateTime.Today);
    var esHoy = desde == hoy && hasta == hoy;
}

<div class="hst-filtros">
    <span class="hst-chip">
        <b>@Model.Count</b> @(Model.Count == 1 ? "comanda" : "comandas")
    </span>

    <span class="flex-grow-1"></span>

    <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
        <input type="date" name="desde" value="@desde?.ToString("yyyy-MM-dd")"
               class="form-control form-control-sm hst-filtro" aria-label="Desde" />
        <input type="date" name="hasta" value="@hasta?.ToString("yyyy-MM-dd")"
               class="form-control form-control-sm hst-filtro" aria-label="Hasta" />
        <select name="receta" asp-items="ViewBag.Recetas"
                class="form-select form-select-sm hst-filtro" style="width: 210px;" aria-label="Receta">
            <option value="">Todas las recetas</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Filtrar</button>
        @if (!esHoy)
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Hoy</a>
        }
    </form>

    <a asp-action="Comandera" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="bi bi-plus-lg"></i> Nueva comanda
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="hst-card">
        <div class="text-center text-muted py-5">
            <i class="bi bi-receipt" style="font-size: 28px; color: var(--sx-celeste);"></i>
            <p class="mb-0 mt-2">
                @(esHoy ? "Todavía no hay comandas hoy." : "No hay comandas con esos filtros.")
            </p>
        </div>
    </div>
}
else
{
    <div class="hst-card">
        <table class="hst-tabla">
            <thead>
                <tr>
                    <th>RECETA</th>
                    <th>SECTOR</th>
                    <th class="num">PORCIONES</th>
                    <th>RESPONSABLE</th>
                    <th class="text-center">MODIFICACIONES</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grupo in Model.GroupBy(c => c.Fecha))
                {
                    <tr class="hst-dia">
                        <td colspan="6">@grupo.Key.ToString("dddd d 'de' MMMM").ToUpperInvariant()</td>
                    </tr>
                    @foreach (var item in grupo)
                    {
                        @* La fila entera abre el detalle: no hace falta un botón Ver *@
                        <tr class="hst-fila" data-href="@Url.Action("Detalle", new { id = item.IdComanda })">
                            <td class="hst-receta">
                                <a asp-action="Detalle" asp-route-id="@item.IdComanda">@item.Receta</a>
                            </td>
                            <td class="text-muted">@item.Clasificacion</td>
                            <td class="num">@item.Porciones</td>
                            <td class="text-muted">@item.Responsable</td>
                            <td class="text-center">
                                @if (item.CantidadModificaciones == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (item.CantidadModificaciones == 1 && item.PrimeraModificacion is not null)
                                {
                                    <span class="hst-mod">@item.PrimeraModificacion.Resumen</span>
                                }
                                else
                                {
                                    <span class="hst-mod">@item.CantidadModificaciones modificaciones</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Pdf" asp-route-id="@item.IdComanda" target="_blank"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Reimprimir PDF">
                                    PDF
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        // La fila lleva al detalle, salvo que se toque un enlace o botón
        document.querySelectorAll(".hst-fila").forEach(fila => {
            fila.addEventListener("click", evento => {
                if (evento.target.closest("a, button")) return;
                window.location = fila.dataset.href;
            });
        });
    </script>
}
