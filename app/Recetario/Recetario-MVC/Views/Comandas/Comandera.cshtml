@model ComanderaViewModel
@using System.Text.Json
@using RecetarioMVC.Models
@{
    ViewData["Title"] = "Comanda de cocina";

    var clasificaciones = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clasificaciones;

    // Ingredientes de cada receta del carrito, para los selects del modal
    var ingredientesJson = JsonSerializer.Serialize(
        Model.IngredientesPorItem.ToDictionary(
            par => par.Key.ToString(),
            par => par.Value.Select(i => new { id = i.IdIngrediente, nombre = i.Ingrediente, unidad = i.Unidad })));
}

<div class="cmd-pantalla">

    @* ==================== Catálogo ==================== *@
    <div>
        <div class="cmd-filtros">
            <form method="get" class="cmd-busca" role="search">
                <input type="hidden" name="clasificacion" value="@Model.IdClasificacion" />
                <input type="search" name="busqueda" value="@Model.Busqueda"
                       class="form-control form-control-sm" placeholder="Buscar…" />
                <button type="submit" class="btn btn-primary btn-sm cmd-lupa" title="Buscar">
                    <i class="bi bi-search"></i>
                </button>
            </form>
            <div class="cmd-chips">
                <a href="@Url.Action("Comandera", new { busqueda = Model.Busqueda })"
                   class="@(Model.IdClasificacion is null ? "activa" : "")">Todas</a>
                @foreach (var c in clasificaciones)
                {
                    <a href="@Url.Action("Comandera", new { busqueda = Model.Busqueda, clasificacion = c.Value })"
                       class="@(c.Selected ? "activa" : "")">@c.Text</a>
                }
            </div>
        </div>

        @if (Model.Catalogo.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-journal-text" style="font-size: 26px; color: var(--sx-celeste);"></i>
                <p class="mb-0 mt-2 small">No hay recetas activas con esos filtros.</p>
            </div>
        }
        else
        {
            @foreach (var receta in Model.Catalogo)
            {
                <div class="cmd-card" data-id="@receta.IdReceta">
                    <div class="cmd-info">
                        <div class="cmd-nombre">
                            @receta.Nombre
                            @if (receta.IngredienteCoincidente is not null)
                            {
                                <span class="cmd-lleva">· lleva @receta.IngredienteCoincidente</span>
                            }
                        </div>
                        <div class="cmd-meta">
                            <span class="cmd-dot d@(receta.IdClasificacion % 4)"></span>@receta.Clasificacion
                            · @receta.CantidadIngredientes @(receta.CantidadIngredientes == 1 ? "ingrediente" : "ingredientes")
                            @if (!receta.Completa)
                            {
                                <span class="advertencia">· ⚠ @receta.Advertencia.ToLowerInvariant()</span>
                            }
                        </div>
                    </div>
                    @if (receta.EnCarrito)
                    {
                        <button type="button" class="cmd-agregar ya" disabled title="Ya está en la comanda">✓</button>
                    }
                    else
                    {
                        <form asp-action="AgregarAlCarrito" method="post">
                            <input type="hidden" name="comensales" value="@Model.Carrito.Comensales" />
                            <input type="hidden" name="seleccion" value="@receta.IdReceta" />
                            <button type="submit" class="cmd-agregar" title="Agregar a la comanda">+</button>
                        </form>
                    }
                </div>
            }
        }
    </div>

    @* ==================== El ticket ==================== *@
    <aside class="cmd-ticket">
        <h2>COMANDA</h2>
        <div class="cmd-fecha">@DateTime.Now.ToString("dddd d 'de' MMMM · HH:mm")</div>
        <hr class="cmd-guiones">

        @if (Model.Carrito.EstaVacio)
        {
            <p class="cmd-vacia">Todavía no hay recetas: agregalas del catálogo con el +.</p>
        }
        else
        {
            @foreach (var item in Model.Carrito.Items)
            {
                <div class="cmd-item">
                    <div class="cmd-item-nombre">@item.Nombre</div>
                    <div class="cmd-item-linea">
                        <span>
                            @item.Clasificacion ·
                            @(Model.Responsables.TryGetValue(item.IdReceta, out var resp) ? resp : "sin responsable")
                        </span>
                        <span class="cmd-item-acciones">
                            <button type="button" class="btn-modificar" title="Modificar ingredientes"
                                    data-bs-toggle="modal" data-bs-target="#modalModificar"
                                    data-id="@item.IdReceta" data-nombre="@item.Nombre">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form asp-action="QuitarDelCarrito" method="post" class="d-inline">
                                <input type="hidden" name="idReceta" value="@item.IdReceta" />
                                <button type="submit" title="Quitar de la comanda"><i class="bi bi-x-lg"></i></button>
                            </form>
                        </span>
                    </div>
                    @for (var i = 0; i < item.Modificaciones.Count; i++)
                    {
                        <span class="cmd-mod">
                            @item.Modificaciones[i].Descripcion
                            <form asp-action="QuitarModificacion" method="post" class="d-inline">
                                <input type="hidden" name="idReceta" value="@item.IdReceta" />
                                <input type="hidden" name="indice" value="@i" />
                                <button type="submit" title="Quitar modificación"><i class="bi bi-x-circle-fill"></i></button>
                            </form>
                        </span>
                    }
                </div>
            }
        }

        <hr class="cmd-guiones">

        <form asp-action="ActualizarComensales" method="post" id="formComensales" class="cmd-comensales">
            <span class="etiqueta">Comensales</span>
            <span class="cmd-stepper">
                <button type="button" data-paso="-1" aria-label="Menos comensales">−</button>
                <input type="number" min="1" id="comensales" name="comensales" value="@Model.Carrito.Comensales" />
                <button type="button" data-paso="1" aria-label="Más comensales">+</button>
            </span>
        </form>

        @if (Model.Revision.Faltantes.Count > 0)
        {
            <hr class="cmd-guiones">
            @foreach (var faltante in Model.Revision.Faltantes)
            {
                <div class="cmd-falta">
                    <span>⚠ Falta @faltante.Ingrediente</span>
                    <span>@faltante.NecesarioTexto <small>(hay @faltante.DisponibleTexto)</small></span>
                </div>
            }
        }

        <hr class="cmd-guiones">

        @if (Model.Carrito.EstaVacio)
        {
            <button type="button" class="btn btn-generar w-100" disabled title="Agregá al menos una receta">
                <i class="bi bi-file-earmark-pdf"></i> Generar comanda
            </button>
        }
        else
        {
            @* Descontar el stock no se deshace: confirma primero *@
            <button type="button" class="btn btn-generar w-100"
                    data-bs-toggle="modal" data-bs-target="#modalGenerar">
                <i class="bi bi-file-earmark-pdf"></i> Generar comanda
            </button>
        }

        <div class="cmd-historial">
            <a asp-action="Index" class="text-decoration-none">
                <i class="bi bi-clock-history"></i> Historial de comandas
            </a>
        </div>
    </aside>
</div>

@* ============ Modal de confirmación ============ *@
@if (!Model.Carrito.EstaVacio)
{
    <div class="modal fade" id="modalGenerar" tabindex="-1" aria-hidden="true">
        @* Scrollable: con muchos faltantes el botón de cerrar tiene que seguir a la vista *@
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generar comanda</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        <b>@Model.Carrito.Items.Count</b>
                        @(Model.Carrito.Items.Count == 1 ? "receta" : "recetas") para
                        <b>@Model.Carrito.Comensales</b>
                        @(Model.Carrito.Comensales == 1 ? "comensal" : "comensales").
                    </p>

                    <ul class="lista-resumen">
                        @foreach (var item in Model.Carrito.Items)
                        {
                            <li>
                                @item.Nombre
                                <span class="text-muted">· @item.Clasificacion</span>
                                @if (item.Modificaciones.Count > 0)
                                {
                                    <span class="text-muted">
                                        · @item.Modificaciones.Count
                                        @(item.Modificaciones.Count == 1 ? "modificación" : "modificaciones")
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (Model.Revision.Faltantes.Count > 0)
                    {
                        <div class="bloque-faltantes">
                            <div class="titulo">
                                <i class="bi bi-exclamation-triangle-fill"></i> No hay stock suficiente
                            </div>
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Ingrediente</th>
                                        <th class="num">Se necesita</th>
                                        <th class="num">Hay</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var faltante in Model.Revision.Faltantes)
                                    {
                                        <tr>
                                            <td>@faltante.Ingrediente</td>
                                            <td class="num">@faltante.NecesarioTexto</td>
                                            <td class="num fw-semibold">@faltante.DisponibleTexto</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="pie">
                                Bajá los comensales, sustituí el ingrediente o cargá stock antes de generar.
                            </div>
                        </div>
                    }

                    @if (Model.Revision.Incompletas.Count > 0)
                    {
                        <div class="bloque-incompletas">
                            @foreach (var aviso in Model.Revision.Incompletas)
                            {
                                <div><i class="bi bi-exclamation-triangle-fill"></i> @aviso</div>
                            }
                        </div>
                    }

                    @if (Model.Revision.SePuedeGenerar)
                    {
                        <p class="text-muted small mb-0">
                            Se descuenta el stock de los ingredientes y se descarga el PDF.
                            La comanda queda registrada.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    @if (Model.Revision.SePuedeGenerar)
                    {
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <form asp-action="Generar" method="post" class="d-inline">
                            <button type="submit" class="btn btn-generar">
                                <i class="bi bi-file-earmark-pdf"></i> Generar comanda
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ============ Modal de modificación ============ *@
<div class="modal fade" id="modalModificar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="GuardarModificacion" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Modificar · <span id="modalReceta"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="IdReceta" id="modalIdReceta" />

                    <div class="mb-3">
                        <label class="form-label" for="modalTipo"><span class="text-danger">*</span> Tipo</label>
                        <select name="Tipo" id="modalTipo" class="form-select" required>
                            <option value="">Elegí el tipo…</option>
                            <option value="@((int)TipoModificacion.Sustitucion)">Sustituir un ingrediente</option>
                            <option value="@((int)TipoModificacion.Adicion)">Agregar un ingrediente</option>
                            <option value="@((int)TipoModificacion.Eliminacion)">Quitar un ingrediente</option>
                        </select>
                    </div>

                    <div class="mb-3 d-none" id="grupoOriginal">
                        <label class="form-label" for="modalOriginal">Ingrediente de la receta</label>
                        <select name="IdIngredienteOriginal" id="modalOriginal" class="form-select"></select>
                    </div>

                    <div class="mb-3 d-none" id="grupoReemplazo">
                        <label class="form-label" for="modalReemplazo">
                            <span id="etiquetaReemplazo">Ingrediente nuevo</span>
                        </label>
                        <select name="IdIngredienteReemplazo" id="modalReemplazo" asp-items="ViewBag.Ingredientes"
                                class="form-select">
                            <option value="">Elegí un ingrediente…</option>
                        </select>
                    </div>

                    <div class="mb-1 d-none" id="grupoCantidad">
                        <label class="form-label" for="modalCantidad">Cantidad para toda la comanda</label>
                        <input name="Cantidad" id="modalCantidad" class="form-control" placeholder="0,00" />
                        <div class="form-text">
                            Total a usar para
                            @(Model.Carrito.Comensales == 1 ? "1 comensal" : $"los {Model.Carrito.Comensales} comensales").
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Modificar receta</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ingredientesPorReceta = @Html.Raw(ingredientesJson);
        const todosLosIngredientes = @Html.Raw(ViewBag.IngredientesJson);
        const comensalesActuales = @Model.Carrito.Comensales;

        // Solo se puede sustituir entre unidades de la misma familia:
        // la cantidad se convierte sola (kg con g, L con ml)
        const familiaDeUnidad = { kg: "masa", g: "masa", l: "volumen", ml: "volumen" };

        function unidadesEquivalentes(a, b) {
            const x = (a || "").toLowerCase();
            const y = (b || "").toLowerCase();
            if (x === y) return true;
            return familiaDeUnidad[x] !== undefined && familiaDeUnidad[x] === familiaDeUnidad[y];
        }

        // ---- Tocar una tarjeta despliega sus ingredientes ----
        document.querySelectorAll(".cmd-card").forEach(card => {
            card.addEventListener("click", evento => {
                if (evento.target.closest("form, button, .cmd-ing")) return;
                alternarIngredientes(card);
            });
        });

        async function alternarIngredientes(card) {
            const estabaAbierta = card.classList.contains("abierta");
            document.querySelectorAll(".cmd-card.abierta").forEach(otra => {
                otra.classList.remove("abierta");
                otra.querySelector(".cmd-ing")?.remove();
            });
            if (estabaAbierta) return;

            card.classList.add("abierta");
            const panel = document.createElement("div");
            panel.className = "cmd-ing";
            panel.innerHTML = '<span class="text-muted">Cargando…</span>';
            card.appendChild(panel);

            const respuesta = await fetch(`@Url.Action("IngredientesReceta")?id=${card.dataset.id}&comensales=${comensalesActuales}`);
            if (!respuesta.ok) {
                panel.innerHTML = '<span class="text-danger">No se pudieron cargar los ingredientes.</span>';
                return;
            }

            const datos = await respuesta.json();
            if (datos.ingredientes.length === 0) {
                panel.innerHTML = '<span class="text-muted">La receta no tiene ingredientes cargados.</span>';
                return;
            }

            panel.innerHTML = datos.ingredientes.map(i => `
                <div class="fila${i.alcanza ? "" : " falta"}">
                    <span>${i.ingrediente}${i.alcanza ? "" : " ⚠"}</span>
                    <span class="pts"></span>
                    <span>${i.cantidadTexto}</span>
                </div>`).join("");
        }

        // ---- Modal de modificación ----
        const modal = document.getElementById("modalModificar");
        modal.addEventListener("show.bs.modal", evento => {
            const boton = evento.relatedTarget;
            const idReceta = boton.dataset.id;

            document.getElementById("modalIdReceta").value = idReceta;
            document.getElementById("modalReceta").textContent = boton.dataset.nombre;
            document.getElementById("modalTipo").value = "";

            document.getElementById("modalOriginal").innerHTML = (ingredientesPorReceta[idReceta] || [])
                .map(i => `<option value="${i.id}">${i.nombre} (${i.unidad})</option>`)
                .join("");

            document.getElementById("modalCantidad").value = "";
            actualizarCampos();
        });

        document.getElementById("modalTipo").addEventListener("change", actualizarCampos);
        document.getElementById("modalOriginal").addEventListener("change", cargarReemplazos);

        /// Al sustituir, solo se ofrecen ingredientes en una unidad equivalente
        function cargarReemplazos() {
            const esSustitucion = document.getElementById("modalTipo").value
                === "@((int)TipoModificacion.Sustitucion)";
            const idOriginal = parseInt(document.getElementById("modalOriginal").value, 10);
            const receta = ingredientesPorReceta[document.getElementById("modalIdReceta").value] || [];
            const original = receta.find(i => i.id === idOriginal);

            const candidatos = todosLosIngredientes.filter(i => {
                if (!esSustitucion) return true;
                if (!original) return true;
                return i.id !== original.id && unidadesEquivalentes(original.unidad, i.unidad);
            });

            const select = document.getElementById("modalReemplazo");
            select.innerHTML = '<option value="">Elegí un ingrediente…</option>' +
                candidatos.map(i => `<option value="${i.id}">${i.nombre} (${i.unidad})</option>`).join("");
        }

        function actualizarCampos() {
            const tipo = document.getElementById("modalTipo").value;
            const sustitucion = tipo === "@((int)TipoModificacion.Sustitucion)";
            const adicion = tipo === "@((int)TipoModificacion.Adicion)";
            const eliminacion = tipo === "@((int)TipoModificacion.Eliminacion)";

            mostrar("grupoOriginal", sustitucion || eliminacion);
            mostrar("grupoReemplazo", sustitucion || adicion);
            // Sustituir y quitar heredan la cantidad del ingrediente original:
            // el cocinero no tiene que calcular nada
            mostrar("grupoCantidad", adicion);

            document.getElementById("etiquetaReemplazo").textContent =
                sustitucion ? "Reemplazar por" : "Ingrediente a agregar";
            document.getElementById("modalCantidad").required = adicion;
            cargarReemplazos();
        }

        function mostrar(id, visible) {
            document.getElementById(id).classList.toggle("d-none", !visible);
        }

        // ---- Comensales: el contador aplica solo, sin botón ----
        const campoComensales = document.getElementById("comensales");
        const formComensales = document.getElementById("formComensales");

        document.querySelectorAll(".cmd-stepper button").forEach(boton => {
            boton.addEventListener("click", () => {
                const actual = parseInt(campoComensales.value, 10) || comensalesActuales;
                campoComensales.value = Math.max(1, actual + parseInt(boton.dataset.paso, 10));
                formComensales.submit();
            });
        });

        // "change" salta al salir del campo o al apretar Enter: no recarga
        // mientras se está tipeando
        campoComensales.addEventListener("change", () => {
            const valor = parseInt(campoComensales.value, 10);

            if (Number.isInteger(valor) && valor > 0) {
                if (valor !== comensalesActuales)
                    formComensales.submit();
                return;
            }

            // Valor vacío o inválido: se vuelve al anterior sin molestar
            campoComensales.value = comensalesActuales;
        });

        @if (ViewBag.HayPdfPendiente == true)
        {
            <text>
            // La comanda recién generada: se baja el PDF con un enlace temporal.
            // Tocar window.location cancelaría el ciclo de vida de la página y
            // se perdía el aviso flotante.
            (function () {
                const enlace = document.createElement("a");
                enlace.href = "@Url.Action("DescargarPdf")";
                enlace.download = "";
                document.body.appendChild(enlace);
                enlace.click();
                enlace.remove();
            })();
            </text>
        }
    </script>
}
