@model ComandaDetalleViewModel
@{
    ViewData["Title"] = $"Comanda #{Model.IdComanda}";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left"></i> Volver a comandas
    </a>
</div>

<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h5 mb-1">
                @Model.Receta <span class="text-muted fw-normal">(@Model.Codigo)</span>
            </h2>
            <span class="text-muted">
                @Model.Fecha.ToString("dd/MM/yyyy") · @Model.Clasificacion ·
                @Model.Porciones comensales · Responsable: @Model.Responsable ·
                Registrada por @Model.Usuario
            </span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Pdf" asp-route-id="@Model.IdComanda" target="_blank"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-file-earmark-pdf"></i> Reimprimir
            </a>
            <a asp-controller="Recetas" asp-action="Detalle" asp-route-id="@Model.IdReceta"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-journal-text"></i> Ver receta
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                @if (Model.Ingredientes.Count == 0)
                {
                    <p class="text-muted mb-0">La receta no tiene ingredientes cargados.</p>
                }
                else
                {
                    @* La tarjeta no lleva título: alcanza con los de las columnas *@
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ingredientes</th>
                                <th class="num">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ing in Model.Ingredientes)
                            {
                                <tr>
                                    <td>@ing.Ingrediente</td>
                                    <td class="num">@FormatoCantidad.Formatear(ing.Cantidad, ing.Unidad)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h6 fw-semibold mb-3">Modificaciones</h3>
                @if (Model.Modificaciones.Count == 0)
                {
                    <p class="text-muted mb-0">Se cocinó según la receta, sin cambios.</p>
                }
                else
                {
                    @* El texto ya dice qué se hizo: una etiqueta con el tipo repetía el verbo *@
                    <ul class="list-unstyled mb-0">
                        @foreach (var m in Model.Modificaciones)
                        {
                            <li class="mb-2">
                                <i class="bi bi-arrow-right-short" style="color: var(--sx-celeste);"></i>
                                @m.Descripcion
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h3 class="h6 fw-semibold mb-3">Procedimiento</h3>
                @if (Model.Pasos.Count == 0)
                {
                    <p class="text-muted mb-0">Sin pasos cargados.</p>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var paso in Model.Pasos)
                        {
                            <li class="mb-2">@paso.Descripcion</li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>
