@model ComandaDetalleViewModel
@{
    ViewData["Title"] = $"Comanda #{Model.IdComanda}";
}

<a asp-action="Index" class="dtc-volver">
    <i class="bi bi-arrow-left"></i> Volver al historial
</a>

<div class="dtc-cabecera">
    <div class="dtc-titulo">
        <div class="nombre">@Model.Receta</div>
        <div class="meta">
            @Model.Clasificacion · @Model.Fecha.ToString("dddd d 'de' MMMM") ·
            generada por @Model.Usuario
        </div>
    </div>
    <div class="dtc-numero">
        <b>@Model.Porciones</b>
        <span>PORCIONES</span>
    </div>
    <a asp-action="Pdf" asp-route-id="@Model.IdComanda" target="_blank"
       class="btn btn-outline-primary btn-sm rounded-pill px-3">
        Descargar PDF
    </a>
</div>

<div class="dtc-columnas">
    <div class="dtc-tarjeta">
        <h4>INGREDIENTES</h4>
        @if (Model.Ingredientes.Count == 0)
        {
            <p class="text-muted mb-0">La receta no tiene ingredientes cargados.</p>
        }
        else
        {
            @* Una sola columna, de arriba a abajo, con las cantidades alineadas *@
            <div class="dtc-lista">
                @foreach (var ing in Model.Ingredientes)
                {
                    <div>
                        <span>@ing.Ingrediente</span>
                        <span class="pts"></span>
                        <span>@FormatoCantidad.Formatear(ing.Cantidad, ing.Unidad)</span>
                    </div>
                }
            </div>
        }
    </div>

    <div>
        <div class="dtc-tarjeta">
            <h4>MODIFICACIONES</h4>
            @if (Model.Modificaciones.Count == 0)
            {
                <p class="text-muted mb-0">Se cocinó según la receta, sin cambios.</p>
            }
            else
            {
                @foreach (var m in Model.Modificaciones)
                {
                    <span class="dtc-mod">@m.Descripcion</span>
                }
            }
        </div>

        <div class="dtc-tarjeta">
            <h4>PROCEDIMIENTO</h4>
            @if (Model.Pasos.Count == 0)
            {
                <p class="text-muted mb-0">Sin pasos cargados.</p>
            }
            else
            {
                @foreach (var paso in Model.Pasos)
                {
                    <div class="dtc-paso">
                        <i>@paso.NroPaso</i>
                        <span>@paso.Descripcion</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
