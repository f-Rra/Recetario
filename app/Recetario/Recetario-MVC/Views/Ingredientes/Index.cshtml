@model IngredientesPaginaViewModel
@using RecetarioMVC.Helpers
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    ViewData["Title"] = "Ingredientes";
    ViewData["SinTitulo"] = true; // la ficha del elegido encabeza la pantalla
    var sel = Model.Seleccionado;

    // El form de edición se renderiza con prefijo para no compartir los
    // nombres de campo con el de alta, que está en la misma página
    var datosEdicion = new ViewDataDictionary(ViewData);
    datosEdicion.TemplateInfo.HtmlFieldPrefix = "Datos";
}

<div class="filtros-cocina">
    <form method="get" class="busca-cocina" role="search">
        <input type="search" name="busqueda" value="@Model.Busqueda"
               class="form-control form-control-sm" placeholder="Buscar…" />
        <button type="submit" class="btn btn-primary btn-sm lupa-cocina" title="Buscar">
            <i class="bi bi-search"></i>
        </button>
    </form>
    <span class="mut-cocina">@Model.Lista.Count @(Model.Lista.Count == 1 ? "ingrediente" : "ingredientes")</span>
    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 ms-auto flex-shrink-0"
            data-bs-toggle="modal" data-bs-target="#modalCrear">
        <i class="bi bi-plus-lg"></i> Nuevo ingrediente
    </button>
</div>

@if (Model.Lista.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-egg-fried" style="font-size: 28px; color: var(--sx-celeste);"></i>
        <p class="mb-0 mt-2">
            @(string.IsNullOrWhiteSpace(Model.Busqueda)
                ? "Todavía no hay ingredientes cargados."
                : "No se encontraron ingredientes con esa búsqueda.")
        </p>
    </div>
}
else
{
    <div class="mdt">
        @* ---------- La lista ---------- *@
        <div class="mdt-lista">
            @foreach (var item in Model.Lista)
            {
                <a asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-id="@item.IdIngrediente"
                   class="@(item.IdIngrediente == sel?.IdIngrediente ? "elegido" : "")">
                    <span class="nombre">@item.Descripcion</span>
                    <span class="dato">@FormatoCantidad.Formatear(item.StockActual, item.Unidad)</span>
                </a>
            }
        </div>

        @* ---------- La ficha ---------- *@
        <div>
            @if (sel is not null)
            {
                <div class="mdt-ficha">
                    <div class="titulo">
                        <div class="nombre">@sel.Descripcion</div>
                        <div class="meta">
                            @sel.Codigo · se mide en @sel.Unidad · @NombreDeposito.De(sel.Deposito).ToLower()
                            · mínimo @FormatoCantidad.Formatear(sel.StockMinimo, sel.Unidad)
                        </div>
                    </div>
                    <div class="numero">
                        @* Formateado como en la lista: 1256 ml se leen 1,26 L en los dos lados *@
                        <b>@FormatoCantidad.Formatear(sel.StockActual, sel.Unidad)</b>
                        <span>EN STOCK</span>
                    </div>
                    @if (sel.Estado == StockEstado.Critico)
                    {
                        <span class="badge rounded-pill badge-estado-critico">Crítico</span>
                    }
                    else if (sel.Estado == StockEstado.Bajo)
                    {
                        <span class="badge rounded-pill badge-estado-bajo">Bajo</span>
                    }
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3"
                            data-bs-toggle="modal" data-bs-target="#modalEditar">Editar</button>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                            data-bs-toggle="modal" data-bs-target="#modalEliminar">Eliminar</button>
                </div>

                <div class="mdt-panel">
                    <h4>PRECIOS</h4>
                    @if (sel.Precios.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            Todavía no tiene precios cargados: sin al menos uno, el costeo de las
                            recetas que lo llevan no se puede calcular.
                        </p>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Proveedor</th>
                                    <th>Vigencia</th>
                                    <th class="num">Precio por @sel.Unidad</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var precio in sel.Precios)
                                {
                                    <tr>
                                        <td>@precio.Proveedor</td>
                                        <td class="text-muted">@precio.FechaVigencia.ToString("dd/MM/yyyy")</td>
                                        <td class="num fw-semibold">$ @precio.Precio.ToString("N2")</td>
                                        <td class="text-end">
                                            @if (precio.EsVigente)
                                            {
                                                <span class="badge rounded-pill badge-estado-ok">Vigente</span>
                                            }
                                            <form asp-action="EliminarPrecio" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Eliminar este precio del historial?');">
                                                <input type="hidden" name="idPrecio" value="@precio.IdPrecio" />
                                                <input type="hidden" name="idIngrediente" value="@sel.IdIngrediente" />
                                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2"
                                                        title="Quitar del historial">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="mt-3">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                data-bs-toggle="modal" data-bs-target="#modalPrecio">
                            <i class="bi bi-plus-lg"></i> Cargar precio
                        </button>
                    </div>
                </div>

                <div class="mdt-panel">
                    <h4>SE USA EN</h4>
                    @if (sel.Recetas.Count == 0)
                    {
                        <p class="text-muted mb-0">Ninguna receta lo lleva todavía.</p>
                    }
                    else
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var receta in sel.Recetas)
                            {
                                <span class="chip-receta">@receta</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@* ============ Alta ============ *@
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo ingrediente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <partial name="_Form" model="Model.Nuevo" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (sel is not null)
{
    @* ============ Edición ============ *@
    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Editar" method="post">
                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                    <div class="modal-header">
                        <h5 class="modal-title">Editar · @sel.Descripcion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <partial name="_Form" model="sel.Datos" view-data="datosEdicion" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ============ Cargar precio ============ *@
    <div class="modal fade" id="modalPrecio" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="AgregarPrecio" method="post">
                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                    <input type="hidden" name="NuevoPrecio.IdIngrediente" value="@sel.IdIngrediente" />
                    <div class="modal-header">
                        <h5 class="modal-title">Cargar precio · @sel.Descripcion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="precioProveedor">
                                <span class="req text-danger">*</span> Proveedor
                            </label>
                            <select name="NuevoPrecio.IdProveedor" id="precioProveedor"
                                    asp-items="ViewBag.Proveedores" class="form-select">
                                <option value="">Elegí un proveedor…</option>
                            </select>
                            <div class="form-text">
                                ¿Falta el proveedor? <a asp-controller="Proveedores" asp-action="Index">Cargalo acá</a>.
                            </div>
                        </div>
                        <div class="row">
                            <div class="col mb-1">
                                <label class="form-label" for="precioMonto">
                                    <span class="req text-danger">*</span> Precio por @sel.Unidad
                                </label>
                                <input name="NuevoPrecio.Precio" id="precioMonto" value="@sel.NuevoPrecio.Precio"
                                       class="form-control" placeholder="0,00" />
                            </div>
                            <div class="col mb-1">
                                <label class="form-label" for="precioFecha">
                                    <span class="req text-danger">*</span> Vigencia
                                </label>
                                <input name="NuevoPrecio.FechaVigencia" id="precioFecha" type="date"
                                       value="@sel.NuevoPrecio.FechaVigencia.ToString("yyyy-MM-dd")"
                                       class="form-control" />
                            </div>
                        </div>
                        <div class="form-text mt-2">
                            El precio más reciente es el que usa el costeo.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Registrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ============ Eliminar ============ *@
    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar ingrediente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    Se va a eliminar <b>@sel.Descripcion</b>. Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Eliminar" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@sel.IdIngrediente" />
                        <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.ModalAbierto is not null)
    {
        @* El formulario volvió con errores: se reabre donde estaba *@
        <script>
            new bootstrap.Modal(document.getElementById("@Model.ModalAbierto")).show();
        </script>
    }
}
